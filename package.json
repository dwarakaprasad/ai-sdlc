{
  "name": "home-tutor",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "vite build && tsx src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "curriculum:check": "tsx src/curriculum/check.ts",
    "test:e2e": "vite build && playwright test",
    "test:docker": "playwright test --config playwright.docker.config.ts"
  },
  "license": "MIT",
  "description": "Self-hosted, Curriculum-driven home tutoring app",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "katex": "^0.19.0",
    "openai": "^6.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  }
}
