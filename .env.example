# Copy this file to .env and fill in the key for the provider you choose in the Parent area.
# .env is git-ignored. Keys are read only from the environment: never stored in the database,
# in markdown or in logs (ADR 0002). `npm start` and `docker compose up` both read .env.

# Anthropic (Claude). Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional settings, shown with their defaults.
# The port for `npm start`.
# PORT=3000
# The host port for `docker compose up`.
# HOME_TUTOR_PORT=3000
# The user and group `docker compose up` runs as, so files in ./data stay yours. Check yours with `id`.
# HOME_TUTOR_UID=1000
# HOME_TUTOR_GID=1000
# Private family data (the SQLite database). Ignored by Docker, which uses the ./data volume.
# HOME_TUTOR_DATA_DIR=data
# Where Curriculum folders live. Ignored by Docker, which uses the ./curricula volume.
# HOME_TUTOR_CURRICULA_DIR=curricula
